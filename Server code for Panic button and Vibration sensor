def create_help_request():

    print()
    print("==============================")
    print("CREATING HELP REQUEST")
    print("==============================")

    data = urllib.parse.urlencode({

        "elderly_id":
            str(ELDERLY_ID),

        "elderly_name":
            ELDERLY_NAME,

        "request_type":
            "emergency",

        "message":
            "Physical panic button pressed",

        "location":
            LOCATION

    }).encode("utf-8")

    try:

        request = urllib.request.Request(

            CREATE_REQUEST_URL,

            data=data,

            method="POST"

        )

        request.add_header(
            "Content-Type",
            "application/x-www-form-urlencoded"
        )

        with urllib.request.urlopen(
            request,
            timeout=15
        ) as response:

            result = (
                response
                .read()
                .decode()
            )

        print()
        print(
            "ATSpace response:"
        )

        print(result)

        # ----------------------------------------------------
        # Try JSON
        # ----------------------------------------------------

        try:

            response_data = json.loads(
                result
            )

            if (
                response_data.get(
                    "success"
                )
                is True
            ):

                print()
                print(
                    "HELP REQUEST CREATED "
                    "SUCCESSFULLY!"
                )

                return True

        except Exception:

            pass

        print()
        print(
            "ATSpace reported an error."
        )

        return False

    except Exception as e:

        print()
        print(
            "ATSpace connection error:"
        )

        print(e)

        return False


