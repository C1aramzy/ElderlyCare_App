# ============================================================
# SHARED TELEGRAM FUNCTION
# ============================================================

def send_telegram(message):

    print()
    print("==============================")
    print("SENDING TELEGRAM ALERT")
    print("==============================")

    print()
    print("Telegram message:")
    print(message)

    # --------------------------------------------------------
    # Check API key
    # --------------------------------------------------------

    if (
        not API_KEY
        or
        API_KEY == ""
    ):

        print()
        print(
            "ERROR: CallMeBot API key "
            "has not been configured."
        )

        return False

    # --------------------------------------------------------
    # Encode message
    # --------------------------------------------------------

    encoded_message = urllib.parse.quote(
        message,
        safe=""
    )

    # --------------------------------------------------------
    # CallMeBot URL
    # --------------------------------------------------------

    url = (
        "https://api.callmebot.com/"
        "telegram/group.php"
        "?apikey="
        + API_KEY
        + "&text="
        + encoded_message
    )

    print()
    print(
        "CallMeBot URL prepared."
    )

    print(
        "Sending message through CallMeBot..."
    )

    try:

        request = urllib.request.Request(

            url,

            headers={
                "User-Agent":
                    "Mozilla/5.0"
            }

        )

        with urllib.request.urlopen(
            request,
            timeout=15
        ) as response:

            status_code = response.status

            result = (
                response
                .read()
                .decode()
            )

        print()
        print("==============================")
        print("CALLMEBOT RESPONSE")
        print("==============================")

        print(
            "HTTP status:",
            status_code
        )

        print(
            "Response:",
            result
        )

        if status_code == 200:

            print()
            print(
                "Telegram alert sent successfully!"
            )

            return True

        print()
        print(
            "CallMeBot returned an error."
        )

        return False

    except urllib.error.HTTPError as e:

        print()
        print("==============================")
        print("CALLMEBOT HTTP ERROR")
        print("==============================")

        print(
            "HTTP status:",
            e.code
        )

        print(
            "Reason:",
            e.reason
        )

        try:

            error_response = (
                e.read()
                .decode()
            )

            print()
            print(
                "CallMeBot error response:"
            )

            print(
                error_response
            )

        except Exception:

            pass

        return False

    except Exception as e:

        print()
        print("==============================")
        print("CALLMEBOT ERROR")
        print("==============================")

        print(
            "Error type:",
            type(e).__name__
        )

        print(
            "Error:",
            e
        )

        return False


