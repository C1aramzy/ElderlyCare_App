# ============================================================
# GET FCM TOKEN FROM ATSPACE
# ============================================================

def get_fcm_token():

    print()
    print("==============================")
    print("GETTING FCM TOKEN")
    print("==============================")

    print(
        "Looking up user ID:",
        VOLUNTEER_ID
    )

    try:

        url = (
            GET_FCM_TOKEN_URL
            + "?user_id="
            + urllib.parse.quote(
                str(VOLUNTEER_ID)
            )
        )

        print()
        print(
            "Requesting:",
            url
        )

        with urllib.request.urlopen(
            url,
            timeout=15
        ) as response:

            result = (
                response
                .read()
                .decode()
            )

        print()
        print("ATSpace FCM response:")
        print(result)

        data = json.loads(result)

        # ----------------------------------------------------
        # Check success
        # ----------------------------------------------------

        if not data.get("success"):

            print()
            print(
                "ERROR: ATSpace could not "
                "retrieve FCM token."
            )

            print(
                data.get(
                    "message",
                    "Unknown error."
                )
            )

            return None

        # ----------------------------------------------------
        # Get token
        # ----------------------------------------------------

        token = data.get(
            "fcm_token"
        )

        if not token:

            print()
            print(
                "ERROR: FCM token is empty."
            )

            return None

        print()
        print(
            "FCM token successfully retrieved."
        )

        print(
            "User ID:",
            data.get("user_id")
        )

        print(
            "Name:",
            data.get("full_name")
        )

        print(
            "Role:",
            data.get("role")
        )

        print(
            "Token length:",
            len(token)
        )

        return token

    except Exception as e:

        print()
        print(
            "ERROR retrieving FCM token:"
        )

        print(e)

        return None


# ============================================================
# SEND GENERIC FCM NOTIFICATION
# ============================================================

def send_fcm_notification(
    title,
    body
):

    print()
    print("==============================")
    print("SENDING FCM NOTIFICATION")
    print("==============================")

    # --------------------------------------------------------
    # Get latest token
    # --------------------------------------------------------

    fcm_token = get_fcm_token()

    if not fcm_token:

        print()
        print(
            "ERROR: Could not get FCM token."
        )

        return False

    # --------------------------------------------------------
    # Create Firebase message
    # --------------------------------------------------------

    try:

        message = messaging.Message(

            notification=messaging.Notification(

                title=title,

                body=body

            ),

            token=fcm_token

        )

        print()
        print(
            "Notification title:"
        )

        print(title)

        print()
        print(
            "Notification body:"
        )

        print(body)

        print()
        print(
            "Sending message to Firebase..."
        )

        response = messaging.send(
            message
        )

        print()
        print(
            "FCM notification sent successfully!"
        )

        print(
            "Firebase message ID:"
        )

        print(response)

        return True

    except Exception as e:

        print()
        print(
            "FCM notification failed:"
        )

        print(
            type(e).__name__
        )

        print(e)

        return False


