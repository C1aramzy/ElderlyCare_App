# ============================================================
# RESET MOTION TIMER
# ============================================================

def reset_motion_timer(
    location
):

    global motion_timer

    with motion_timer_lock:

        # ----------------------------------------------------
        # Cancel previous timer
        # ----------------------------------------------------

        if motion_timer is not None:

            motion_timer.cancel()

            print()
            print(
                "Previous 30-second timer "
                "cancelled."
            )

        # ----------------------------------------------------
        # Start new timer
        # ----------------------------------------------------

        print()
        print(
            "Starting 30-second "
            "inactivity timer..."
        )

        motion_timer = threading.Timer(

            MOTION_TIMEOUT,

            motion_timeout_reached,

            args=[location]

        )

        motion_timer.daemon = True

        motion_timer.start()

        print(
            "Timer started."
        )

        print(
            "Notification will be sent "
            "if no new motion arrives "
            "within",
            MOTION_TIMEOUT,
            "seconds."
        )


# ============================================================
# HTTP SERVER
# ============================================================

class ElderlyHandler(
    BaseHTTPRequestHandler
):

    # ========================================================
    # GET REQUEST
    # ========================================================

    def do_GET(self):

        print()
        print("==============================")
        print("REQUEST RECEIVED")
        print("==============================")

        print(
            "Path:",
            self.path
        )

        # ====================================================
        # PARSE URL
        # ====================================================

        parsed = urllib.parse.urlparse(
            self.path
        )

        params = urllib.parse.parse_qs(
            parsed.query
        )

        # ====================================================
        # PANIC ENDPOINT
        # ====================================================

        if parsed.path == "/panic":

            self.handle_panic()

            return

        # ====================================================
        # MOTION ENDPOINT
        # ====================================================

        elif parsed.path == "/motion":

            self.handle_motion(
                params
            )

            return

        # ====================================================
        # DEFAULT
        # ====================================================

        else:

            response = (
                "Elderly monitoring "
                "server is running."
            )

            self.send_response(200)

            self.send_header(
                "Content-Type",
                "text/plain"
            )

            self.send_header(
                "Content-Length",
                str(
                    len(
                        response.encode()
                    )
                )
            )

            self.end_headers()

            self.wfile.write(
                response.encode()
            )


    # ========================================================
    # HANDLE PANIC
    # ========================================================

    def handle_panic(self):

        print()
        print("==============================")
        print(
            "PANIC REQUEST RECEIVED!"
        )
        print("==============================")


        # ----------------------------------------------------
        # 1. Create help request
        # ----------------------------------------------------

        atspace_success = (
            create_help_request()
        )


        # ----------------------------------------------------
        # 2. Send FCM
        # ----------------------------------------------------

        fcm_success = (
            send_fcm_panic_notification()
        )


        # ----------------------------------------------------
        # 3. Send Telegram
        # ----------------------------------------------------

        telegram_success = (
            send_telegram_panic_notification()
        )


        # ----------------------------------------------------
        # Print results
        # ----------------------------------------------------

        print()
        print("==============================")
        print(
            "PANIC ALERT RESULTS"
        )
        print("==============================")

        print(
            "ATSpace help request:",
            "SUCCESS"
            if atspace_success
            else "FAILED"
        )

        print(
            "Flutter FCM notification:",
            "SUCCESS"
            if fcm_success
            else "FAILED"
        )

        print(
            "Telegram notification:",
            "SUCCESS"
            if telegram_success
            else "FAILED"
        )


        # ----------------------------------------------------
        # Response to Pico
        # ----------------------------------------------------

        if (
            atspace_success
            or
            fcm_success
            or
            telegram_success
        ):

            response = (
                "PANIC ALERT SENT"
            )

        else:

            response = (
                "FAILED TO SEND "
                "PANIC ALERT"
            )


        self.send_response(200)

        self.send_header(
            "Content-Type",
            "text/plain"
        )

        self.send_header(
            "Content-Length",
            str(
                len(
                    response.encode()
                )
            )
        )

        self.end_headers()

        self.wfile.write(
            response.encode()
        )


    # ========================================================
    # HANDLE MOTION
    # ========================================================

    def handle_motion(
        self,
        params
    ):

        print()
        print("==============================")
        print(
            "MOTION REQUEST RECEIVED!"
        )
        print("==============================")


        # ----------------------------------------------------
        # Get values from Pico
        # ----------------------------------------------------

        movement = params.get(
            "movement",
            ["0"]
        )[0]

        location = params.get(
            "location",
            ["unknown"]
        )[0]


        print()
        print(
            "Movement:",
            movement
        )

        print(
            "Location:",
            location
        )


        # ====================================================
        # 1. SAVE MOTION DATA
        # ====================================================

        atspace_success = (
            send_motion_to_atspace(
                movement,
                location
            )
        )


        # ====================================================
        # 2. RESET INACTIVITY TIMER
        # ====================================================

        reset_motion_timer(
            location
        )


        # ====================================================
        # PRINT RESULTS
        # ====================================================

        print()
        print("==============================")
        print(
            "MOTION RESULTS"
        )
        print("==============================")

        print(
            "ATSpace motion data:",
            "SUCCESS"
            if atspace_success
            else "FAILED"
        )

        print(
            "Inactivity timer:",
            "RESET"
        )


        # ====================================================
        # RESPONSE TO PICO
        # ====================================================

        if atspace_success:

            response = (
                "MOTION DATA SENT"
            )

        else:

            response = (
                "MOTION TIMER RESET"
            )


        self.send_response(200)

        self.send_header(
            "Content-Type",
            "text/plain"
        )

        self.send_header(
            "Content-Length",
            str(
                len(
                    response.encode()
                )
            )
        )

        self.end_headers()

        self.wfile.write(
            response.encode()
        )


    # ========================================================
    # HIDE HTTP SERVER LOGS
    # ========================================================

    def log_message(
        self,
        format,
        *args
    ):

        pass


